datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

// Exactly matches status lifecycle in poetry-shorts-maker, plus the Buffer
// scheduling states that continue after the worker run has finished.
enum JobStatus {
  queued
  processing
  rendered
  submitting
  scheduled
  publishing
  partial
  published
  completed
  failed
}

// One Buffer post, for one destination (platform) of one voice.
enum PublishStatus {
  scheduled
  publishing
  published
  failed
}

enum ReelStyle {
  A
  B
}

// Where a user's voice files live. REMOTE keeps today's Cloudinary flow; LOCAL
// writes to a folder shared with the render engine and passes absolute paths.
enum StorageMode {
  LOCAL
  REMOTE
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique
  name         String?              @db.VarChar(80)
  passwordHash String
  role         Role                 @default(USER)
  active       Boolean              @default(true)
  storage_mode StorageMode          @default(REMOTE)
  // Built-in avatar path, custom image data URL, or null for the default.
  avatar_url   String?              @db.Text
  // Per-user Cloudinary account. The API secret is encrypted with AES-256-GCM.
  cloudinary_cloud_name String?     @db.VarChar(100)
  cloudinary_api_key    String?     @db.VarChar(200)
  cloudinary_api_secret String?     @db.Text
  channels     Channel[]
  queueRuns    QueueRun[]
  voices       Voice[]
  postingTimes ChannelPostingTime[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// An app-level channel: a group of Buffer destinations that share one Buffer
// account, one language, and one list of remembered UTC posting times.
model Channel {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String               @db.Uuid
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String               @db.VarChar(80)
  language                 String               @default("en") @db.VarChar(20)
  language_group           String               @default("en") @db.VarChar(10)
  reel_style               ReelStyle            @default(A)
  aspect_ratio             String               @default("9:16") @db.VarChar(10)
  enabled                  Boolean              @default(true)
  buffer_organization_id   String?              @db.VarChar(100)
  buffer_organization_name String?              @db.VarChar(200)
  buffer_access_token      String               @db.Text // Encrypted with AES-256-GCM
  destinations             ChannelDestination[]
  voices                   Voice[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([userId])
  @@index([userId, language_group])
}

// One Buffer channel = one social destination inside an app channel.
model ChannelDestination {
  id                  String         @id @default(uuid()) @db.Uuid
  channelId           String         @db.Uuid
  channel             Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  buffer_channel_id   String         @db.VarChar(200)
  name                String         @db.VarChar(200)
  service             String         @db.VarChar(50)
  avatar              String?        @db.Text
  enabled             Boolean        @default(true)
  is_disconnected     Boolean        @default(false)
  is_locked           Boolean        @default(false)
  is_queue_paused     Boolean        @default(false)
  youtube_category_id String?        @db.VarChar(5)
  last_synced_at      DateTime?
  publishes           VoicePublish[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([channelId, buffer_channel_id])
  @@index([channelId])
}

// Remembered posting times, per user and language group. Time only, never a
// date: dates are always chosen fresh for each voice.
model ChannelPostingTime {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language_group String   @db.VarChar(10)
  time_minutes   Int
  use_count      Int      @default(1)
  last_used_at   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([userId, language_group, time_minutes])
  @@index([userId, language_group, last_used_at])
}

// Represents a "Process saved voices" execution run across all user channels
model QueueRun {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          JobStatus @default(processing)
  total_items     Int       @default(0)
  completed_items Int       @default(0)
  voices          Voice[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
}

