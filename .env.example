# Project 01 - SaaS platform & orchestrator
# Copy this file to .env and fill in real values.

PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/poetry_shorts_saas
REDIS_URL=redis://localhost:6379

# NextAuth
NEXTAUTH_SECRET=generate-random-secret
NEXTAUTH_URL=http://localhost:3000

# Buffer token encryption key (32-byte hex for AES-256-GCM)
# Generate with: openssl rand -hex 32
BUFFER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cloudinary is configured per user in Profile > Cloudinary inside the app.
# The SaaS does not read Cloudinary credentials from the environment.
#
# Project 02 (render engine) still uploads remote-mode reels with its own
# separate Cloudinary account, configured in that project.

# Local storage mode (optional). Must be the same absolute folder that the
# render engine uses, and writable by both processes.
LOCAL_MEDIA_ROOT=

# Internal service URLs
RENDER_SERVICE_URL=http://localhost:8000
UPLOAD_SERVICE_URL=http://localhost:8001
WEBHOOK_BASE_URL=http://localhost:3000

# Service-to-service API keys
# Must match VIDEO_BUILDER_API_KEY in ../poetry-shorts-maker
RENDER_SERVICE_API_KEY=internal-service-key
# Must match SERVICE_API_KEY in ../poetry-shorts-uploader (sent as X-API-Key)
UPLOAD_SERVICE_API_KEY=internal-uploader-key

# Shared secret for incoming render/publish webhooks. When set, Project 02 and
# Project 03 must send it as the `X-Webhook-Secret` header. Recommended in
# production; leave empty only for local development.
WEBHOOK_SECRET=

# Worker tuning (optional)
WORKER_POLL_INTERVAL_MS=2000
RENDER_TIMEOUT_MS=1800000
SERVICE_REQUEST_TIMEOUT_MS=30000
# How often the worker re-checks due Buffer posts (milliseconds)
STATUS_SYNC_INTERVAL_MS=120000

# Seed admin (npm run db:seed)
SEED_ADMIN_EMAIL=admin@poetryshorts.local
SEED_ADMIN_PASSWORD=change-me-admin
